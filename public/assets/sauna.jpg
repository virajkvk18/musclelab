<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="1200" height="800">
  <defs>
    <radialGradient id="saunaGlow" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#361a08"/>
      <stop offset="60%" stop-color="#120c06"/>
      <stop offset="100%" stop-color="#050507"/>
    </radialGradient>
    <linearGradient id="woodSlats" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#7c4623"/>
      <stop offset="50%" stop-color="#4f2a11"/>
      <stop offset="100%" stop-color="#2a1408"/>
    </linearGradient>
    <linearGradient id="emberGlow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ff8c00"/>
      <stop offset="50%" stop-color="#ffb800"/>
      <stop offset="100%" stop-color="#ff4500"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="800" fill="url(#saunaGlow)"/>

  <!-- Cedar / Scandinavian Wood Slats Architecture -->
  <g opacity="0.4">
    <!-- Horizontal Slats -->
    <rect x="100" y="80" width="1000" height="24" rx="4" fill="url(#woodSlats)"/>
    <rect x="100" y="120" width="1000" height="24" rx="4" fill="url(#woodSlats)"/>
    <rect x="100" y="160" width="1000" height="24" rx="4" fill="url(#woodSlats)"/>
    <rect x="100" y="200" width="1000" height="24" rx="4" fill="url(#woodSlats)"/>
    <rect x="100" y="240" width="1000" height="24" rx="4" fill="url(#woodSlats)"/>
    <rect x="100" y="280" width="1000" height="24" rx="4" fill="url(#woodSlats)"/>
    <rect x="100" y="320" width="1000" height="24" rx="4" fill="url(#woodSlats)"/>
  </g>

  <!-- Sauna Steam Ambient Waves -->
  <path d="M 400 460 Q 420 360 480 340 T 540 220" fill="none" stroke="#ffb800" stroke-width="4" stroke-linecap="round" opacity="0.3"/>
  <path d="M 600 480 Q 640 380 620 320 T 670 200" fill="none" stroke="#ffb800" stroke-width="6" stroke-linecap="round" opacity="0.2"/>
  <path d="M 750 490 Q 720 370 790 310 T 760 180" fill="none" stroke="#ffb800" stroke-width="5" stroke-linecap="round" opacity="0.25"/>

  <!-- Heated Rock Stove / Finnish Coal Heater -->
  <g transform="translate(600, 480)">
    <!-- Stove Outer Cage -->
    <rect x="-140" y="-80" width="280" height="180" rx="16" fill="#15151a" stroke="url(#emberGlow)" stroke-width="2.5"/>
    <!-- Internal Hot Glowing Coals -->
    <circle cx="-60" cy="-20" r="28" fill="#ff4500" opacity="0.8"/>
    <circle cx="0" cy="-35" r="34" fill="#ff8c00" opacity="0.9"/>
    <circle cx="60" cy="-15" r="30" fill="#ffb800" opacity="0.85"/>
    <circle cx="-30" cy="30" r="25" fill="#ff3300" opacity="0.75"/>
    <circle cx="35" cy="25" r="28" fill="#ffa500" opacity="0.8"/>
    <!-- Lava rock texture outlines -->
    <ellipse cx="0" cy="0" rx="90" ry="50" fill="none" stroke="#ffe4b5" stroke-width="1" opacity="0.4"/>
  </g>

  <!-- Temperature & Humidity HUD Display -->
  <g transform="translate(600, 200)">
    <rect x="-150" y="-35" width="300" height="70" rx="16" fill="rgba(15,10,6,0.9)" stroke="url(#emberGlow)" stroke-width="1.5"/>
    <text x="0" y="-5" font-family="'JetBrains Mono', monospace" font-size="24" font-weight="900" fill="#ffb800" text-anchor="middle">85°C // 185°F</text>
    <text x="0" y="18" font-family="'JetBrains Mono', monospace" font-size="10" font-weight="700" fill="#f8fafc" text-anchor="middle" letter-spacing="2">SCANDINAVIAN THERMAL SUITE</text>
  </g>

  <!-- Telemetry Badge Overlay -->
  <g transform="translate(600, 680)">
    <rect x="-240" y="-30" width="480" height="60" rx="16" fill="rgba(10,10,14,0.85)" stroke="#ffb800" stroke-width="1.5"/>
    <text x="0" y="-4" font-family="'Syne', sans-serif" font-size="16" font-weight="900" fill="#ffffff" text-anchor="middle" letter-spacing="2">THERMAL SAUNA &amp; RECOVERY</text>
    <text x="0" y="18" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700" fill="#ffb800" text-anchor="middle" letter-spacing="1">HEAT SHOCK PROTEINS • METABOLIC RESET • RELAXATION</text>
  </g>
</svg>
